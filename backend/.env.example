DATABASE_URL="postgresql://rewind:rewind@localhost:5433/rewind"
JWT_SECRET=

# API de música (todas opcionais; valores padrão abaixo)
MUSIC_PROVIDER=deezer
DEEZER_API_URL=https://api.deezer.com
MUSIC_API_TIMEOUT_MS=5000
# 0 desliga o cache em memória
MUSIC_CACHE_TTL_SECONDS=600

# Fotos de perfil. Sem estas variáveis, ficam em backend/uploads (desenvolvimento local).
# No deploy da Vercel, conectar o Blob ao projeto define BLOB_STORE_ID sozinho.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
